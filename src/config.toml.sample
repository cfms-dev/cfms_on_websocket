# Deployment settings are read at startup; changes require a restart.
# Business policies: see docs/DATABASE_OPTIONS.md and `maintain config options`.
# Enable debug mode for verbose logging and additional debugging features
debug = false

[server]
# Display name is managed with `maintain config options`, under core/server.
# Host address to bind the server to
host = "localhost"
# Port to listen on
port = 5104
# Enable dual-stack IPv6 (bind to both IPv4 and IPv6 if host allows)
dualstack_ipv6 = true
# Global key for pagination cursor encryption and rate-limit identity digests.
# User authentication tokens use independent signing keys stored in the database.
secret_key = ""
# Path to the SSL/TLS private key file
ssl_keyfile = "./content/ssl/key.pem"
# Path to the SSL/TLS certificate file
ssl_certfile = "./content/ssl/cert.pem"
# Apply certificate/key file updates to new TLS handshakes without restarting.
# Shared by WSS and the HTTP API; these settings are captured at startup.
ssl_reload_enabled = true
ssl_reload_debounce_seconds = 0.5
ssl_reload_scan_interval_seconds = 30.0
# Reverse proxies allowed to supply X-Forwarded-For or X-Real-IP.
trusted_proxy_networks = ["127.0.0.1/32", "::1/128"]

# Server-side chunk-size limit for uploads and downloads (default is 2MB)
file_chunk_size = 2097152 # 2MB
# Setting the chunk size too high may cause transfer failures depending on client configuration

[server.admission_control]
# Hard per-process resource ceilings. These remain enforced even while request
# rate control is disabled or observing.
max_connections = 64
max_connections_per_ip = 16
# Keep below database.pool total capacity to leave room for background work.
max_inflight_requests = 12
max_inflight_requests_per_connection = 8
max_pending_streams_per_connection = 16
busy_retry_after_seconds = 1

[security]
# Pepper used for password hashing
pepper = ""
# Password and risk policies are managed with `maintain config options`.

# Whether to require clients to provide a certificate for authentication.
# If enabled, the server will verify if the client certificate is trusted.
require_client_cert = false

# Path to the trusted CA certificate store for client certificates. 
# Must point to a directory, and certificates within must follow OpenSSL naming conventions.
# Only takes effect when require_client_cert is true.
client_cert_ca_path = "./content/ssl/client/"

[scheduling]
# Runtime settings for the always-on scheduling core.
# Worker threads started by each server instance for either scheduling Provider.
# Required when provider.scheduling = "redis". Use one stable value on every
# node in a deployment and a different value for deployments sharing Redis.
# redis_namespace = "replace-with-deployment-id"
worker_threads = 4
poll_interval_seconds = 1.0
execution_lease_seconds = 60
lease_refresh_seconds = 20
shutdown_grace_seconds = 30
claim_batch_size = 100

[database]
# Database type to use ("sqlite", "mysql", or "postgresql")
type = "sqlite"

# Specify the database file name if using SQLite
file = "app.db"

# Specify connection properties if using MySQL or PostgreSQL
host = "localhost"
port = 3306 # Use 5432 for PostgreSQL
username = ""
password = ""
# Specify the database name if using MySQL or PostgreSQL
name = "app_db"
# Specify the character set if using MySQL
charset = "utf8mb4"
options = "" # Not implemented yet

# QueuePool settings for file-based SQLite, MySQL, and PostgreSQL. Changes
# require a server restart. In-memory SQLite keeps its dedicated pool behavior.
[database.pool]
size = 5
max_overflow = 10
timeout_seconds = 30

[provider]
# Caching provider ("memory" or "redis")
caching = "memory" # "memory" or "redis"
# Storage provider ("local" or "s3")
storage = "local" # "local" or "s3"
# Event bus provider ("local" or "redis")
event_bus = "local" # "local" or "redis"
# Request rate-limit state provider ("memory" or "redis")
rate_limit = "memory" # "memory" or "redis"
# Scheduled-task runtime ("local" or "redis")
scheduling = "local"

[redis]
# Redis server host
host = "localhost"
# Redis server port
port = 6379
# Redis server password (leave empty if not required)
password = ""
# Redis database index
db = 0

[s3]
# S3 bucket name
bucket = ""
# Custom S3 endpoint URL (optional, useful for MinIO, R2, etc.)
endpoint_url = ""
# S3 Access Key ID
access_key_id = ""
# S3 Secret Access Key
secret_access_key = ""
# S3 session token for temporary explicit credentials (optional)
session_token = ""
# S3 region name (e.g., "us-east-1")
region_name = ""
# S3 addressing style ("auto", "virtual", or "path")
addressing_style = "auto"
# Number of reusable HTTP connections; defaults to server admission capacity
max_pool_connections = 64

[extensions]
# Extension identifiers to load, in registration order. Changes require a restart.
# Add "scheduled_lockdown" to schedule lockdown transitions or windows.
enabled = []

# Brute-force lockdown policy is managed with `maintain config options`, under
# security.brute_force_lockdown; enable the extension above to use the detector.

# Optional HTTPS API framework for extension-owned APIRouter registrations.
# Install with `uv sync --extra ext-http-api` and add "http_api" to enabled.
# All settings in this table require a server restart to take effect.
[extensions.http_api]
host = "localhost"
port = 5105
# Omit both values to reuse server.ssl_certfile and server.ssl_keyfile.
# ssl_certfile = "./content/ssl/http-cert.pem"
# ssl_keyfile = "./content/ssl/http-key.pem"
max_concurrency = 64  # Exact number of simultaneous HTTP connections admitted.
max_request_body_bytes = 1048576  # Hard raw-body limit, including streamed bodies.
request_header_timeout_seconds = 10.0  # Total time to receive complete headers.
request_body_timeout_seconds = 30.0  # Total time to receive the complete body.
startup_timeout_seconds = 10.0
shutdown_timeout_seconds = 10.0
cors_allowed_origins = []  # Browser origins only: scheme://host[:port], without a trailing slash.
docs_enabled = false

# Optional OpenID Connect single sign-on.
# Install with `uv sync --extra ext-oidc-sso` and add "oidc_sso" to enabled.
[extensions.oidc_sso]
# Issuer URL of the OpenID Provider, without a trailing slash.
issuer = ""
# OAuth/OIDC client credentials registered with the provider.
client_id = ""
client_secret = ""
# Redirect URI registered with the provider and used by the client.
redirect_uri = ""
# User mapping and auto-provisioning are managed in the identity.oidc database namespace.
